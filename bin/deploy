#!/usr/bin/env bash
# Publishes the committed site to altyncore.kz and checks the live files.
#   bin/deploy
# How it works: push to github.com/AltynCore/altyncore-site, then the Plesk Git webhook makes the
# server pull main and check it out into httpdocs. Plesk only writes the repository's files.
# The webhook address (with its uuid) is in the macOS keychain, item altyncore-site-deploy-hook;
# it is in Plesk: altyncore.kz → Git → repository settings.
set -euo pipefail
cd "$(dirname "$0")/.."
SITE=${SITE:-https://altyncore.kz}

[ -z "$(git status --porcelain)" ] || { echo "Uncommitted changes: commit first, the deploy sends HEAD." >&2; exit 1; }
hook=$(security find-generic-password -s altyncore-site-deploy-hook -a altyncore.kz -w 2>/dev/null) || {
  echo "No Plesk webhook in the keychain. Copy it from Plesk (altyncore.kz → Git → repository settings) and save:" >&2
  echo "  security add-generic-password -U -s altyncore-site-deploy-hook -a altyncore.kz -w '<webhook url>'" >&2
  exit 1
}

git push -q origin HEAD:main
curl -fsS -o /dev/null -X POST "$hook"
echo "Pushed $(git rev-parse --short HEAD), Plesk is deploying"

# Done when every served file on the site is byte for byte the committed one.
url_of() { case "$1" in index.html) echo /;; *) echo "/$1";; esac; }
mismatched() {
  local file
  for file in $(git ls-files '*.html' '*.txt' '*.xml'); do
    [ "$(curl -s "$SITE$(url_of "$file")?v=$RANDOM" | shasum -a 256 | cut -d' ' -f1)" = "$(git show "HEAD:$file" | shasum -a 256 | cut -d' ' -f1)" ] \
      || echo "$file"
  done
}
for _ in $(seq 1 30); do
  left=$(mismatched)
  [ -z "$left" ] && break
  sleep 2
done

failed=0
[ -z "$left" ] || { echo "  not the committed version on the site: $(echo $left)" >&2; failed=1; }
for hidden in /README.md /bin/deploy /zettel/; do
  code=$(curl -s -o /dev/null -w '%{http_code}' "$SITE$hidden")
  [ "$code" = 404 ] || { echo "  $hidden -> $code, must be 404" >&2; failed=1; }
done
[ "$failed" = 0 ] && echo "Live check passed: $SITE serves $(git rev-parse --short HEAD)" || { echo "Live check failed" >&2; exit 1; }
